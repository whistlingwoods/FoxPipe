<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/instanceHelpTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pilot_surface_variant"
        android:clipToOutline="true"
        android:padding="16dp"
        android:autoLink="web"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="@string/peertube_instance_url_help" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/instances"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/instanceHelpTV"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pilot_surface"
        android:clipToOutline="true"
        android:clipToPadding="false"
        android:padding="8dp"
        tools:listitem="@layout/item_instance" />

    <!-- LOADING INDICATOR-->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading_progress_bar"
        style="@style/Widget.NewPipe.CircularProgressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addInstanceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorPrimaryContainer"
        app:tint="?attr/colorOnPrimaryContainer"
        app:fabSize="auto" />

</RelativeLayout>
