<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:theme="@style/ThemeOverlay.NewPipe.Player"
    tools:context="org.schabi.newpipe.player.PlayQueueActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/pilot_app_bar_color"
        android:theme="@style/ToolbarTheme"
        app:popupTheme="@style/ToolbarPopupTheme">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_weight="1"
            android:background="?attr/pilot_app_bar_color"
            android:theme="@style/ToolbarTheme"
            app:layout_scrollFlags="scroll|enterAlways"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/play_queue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/metadata"
        android:layout_below="@id/appbar"
        android:scrollbars="vertical"
        android:theme="@style/PlayQueueItemTextTheme"
        app:layoutManager="LinearLayoutManager"
        tools:listitem="@layout/play_queue_item" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/seek_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_above="@id/metadata"
        android:background="@drawable/bg_player_md3_seek_label"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="RtlHardcoded"
        tools:text="1:06:29"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/progress_bar"
        android:layout_marginStart="@dimen/player_md3_section_spacing"
        android:layout_marginEnd="@dimen/player_md3_section_spacing"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_player_md3_panel_ripple"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp"
        tools:ignore="RtlHardcoded,RtlSymmetry">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/song_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:fadingEdge="horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.NewPipe.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis nec aliquam augue, eget cursus est. Ut id tristique enim, ut scelerisque tellus. Sed ultricies ipsum non mauris ultricies, commodo malesuada velit porta." />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:fadingEdge="horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.NewPipe.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Duis posuere arcu condimentum lobortis mattis." />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/playback_controls"
        android:layout_marginStart="@dimen/player_md3_section_spacing"
        android:layout_marginEnd="@dimen/player_md3_section_spacing"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_player_md3_panel"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/current_time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="-:--:--"
            android:textColor="?attr/colorOnSurface"
            tools:ignore="HardcodedText"
            tools:text="1:06:29" />


        <org.schabi.newpipe.views.FocusAwareSeekBar
            android:id="@+id/seek_bar"
            style="@style/Widget.NewPipe.SeekBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:value="25"
            android:valueFrom="0"
            android:valueTo="100" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/end_time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="-:--:--"
            android:textColor="?attr/colorOnSurface"
            tools:ignore="HardcodedText"
            tools:text="1:23:49" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/live_sync"
            style="@style/Widget.NewPipe.Player.TextChip.Emphasized"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/duration_live"
            android:textAllCaps="true"
            android:visibility="gone" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/playback_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_md3_panel"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="@dimen/player_md3_section_spacing"
        android:layout_marginEnd="@dimen/player_md3_section_spacing"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        tools:ignore="RtlHardcoded">

        <org.schabi.newpipe.views.PilotIconButton
            android:id="@+id/control_repeat"
            style="@style/Widget.NewPipe.Player.IconButton"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_toLeftOf="@+id/control_backward"
            android:clickable="true"
            android:contentDescription="@string/notification_action_repeat"
            android:focusable="true"
            app:icon="@drawable/ic_repeat"
            tools:ignore="ContentDescription" />

        <org.schabi.newpipe.views.PilotIconButton
            android:id="@+id/control_backward"
            style="@style/Widget.NewPipe.Player.IconButton"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:layout_toLeftOf="@+id/control_fast_rewind"
            android:clickable="true"
            android:contentDescription="@string/previous_stream"
            android:focusable="true"
            app:icon="@drawable/ic_previous"
            tools:ignore="ContentDescription" />

        <org.schabi.newpipe.views.PilotIconButton
            android:id="@+id/control_fast_rewind"
            style="@style/Widget.NewPipe.Player.IconButton"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:layout_toLeftOf="@id/control_play_pause"
            android:clickable="true"
            android:contentDescription="@string/rewind"
            android:focusable="true"
            app:icon="@drawable/exo_controls_rewind" />

        <org.schabi.newpipe.views.PilotIconButton
            android:id="@+id/control_play_pause"
            style="@style/Widget.NewPipe.Player.IconButton.Filled"
            android:layout_width="@dimen/player_control_large_button_size"
            android:layout_height="@dimen/player_control_large_button_size"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:clickable="true"
            android:contentDescription="@string/pause"
            android:focusable="true"
            app:icon="@drawable/ic_pause"
            tools:ignore="ContentDescription" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/control_progress_bar"
            style="@style/Widget.NewPipe.CircularProgressIndicator.OnDark.Small"
            android:layout_width="@dimen/player_control_large_button_size"
            android:layout_height="@dimen/player_control_large_button_size"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="#00000000"
            android:clickable="false"
            android:indeterminate="true"
            android:padding="2dp"
            android:visibility="invisible"
            tools:visibility="visible" />


        <org.schabi.newpipe.views.PilotIconButton
            android:id="@+id/control_fast_forward"
            style="@style/Widget.NewPipe.Player.IconButton"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:layout_centerVertical="true"
            android:layout_marginRight="5dp"
            android:layout_toRightOf="@id/control_play_pause"
            android:clickable="true"
            android:contentDescription="@string/forward"
            android:focusable="true"
            app:icon="@drawable/exo_controls_fastforward" />

        <org.schabi.newpipe.views.PilotIconButton
            android:id="@+id/control_forward"
            style="@style/Widget.NewPipe.Player.IconButton"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:layout_centerVertical="true"
            android:layout_marginRight="5dp"
            android:layout_toRightOf="@+id/control_fast_forward"
            android:clickable="true"
            android:contentDescription="@string/next_stream"
            android:focusable="true"
            app:icon="@drawable/ic_next"
            tools:ignore="ContentDescription" />

        <org.schabi.newpipe.views.PilotIconButton
            android:id="@+id/control_shuffle"
            style="@style/Widget.NewPipe.Player.IconButton"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_toRightOf="@+id/control_forward"
            android:clickable="true"
            android:contentDescription="@string/notification_action_shuffle"
            android:focusable="true"
            app:icon="@drawable/ic_shuffle"
            tools:ignore="ContentDescription" />

    </RelativeLayout>
</RelativeLayout>
