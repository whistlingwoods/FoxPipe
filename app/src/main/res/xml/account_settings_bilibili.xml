<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_category_bilibili_account_title">

    <Preference
        android:key="@string/login_key"
        android:summary="@string/login_warning"
        android:title="@string/login_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="@string/logout_key"
        android:title="@string/logout_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/override_cookies_bilibili_key"
        android:summary="@string/override_cookies_summary"
        android:title="@string/override_cookies_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <EditTextPreference
        android:defaultValue=""
        android:inputType="text"
        android:key="@string/override_cookies_bilibili_value_key"
        android:title="@string/override_cookies_value_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <MultiSelectListPreference
        android:defaultValue="@array/cookie_functions_bilibili_values"
        android:entries="@array/cookie_functions_bilibili_entries"
        android:entryValues="@array/cookie_functions_bilibili_values"
        android:key="@string/cookie_functions_bilibili_key"
        android:title="@string/cookie_functions_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />
</PreferenceScreen>
